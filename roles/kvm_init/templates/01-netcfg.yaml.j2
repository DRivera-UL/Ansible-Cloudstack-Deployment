network:
  version: 2
  renderer: networkd
  ethernets:
    {{ ansible_default_ipv4.interface }}:
      dhcp4: false
      dhcp6: false
      optional: true
  bridges:
    cloudbr0:
      addresses: [{{ ansible_default_ipv4.address }}/24]
      routes:
        - to: default
          via: {{ ansible_default_ipv4.gateway }}
      nameservers:
        addresses: [1.1.1.1, 1.0.0.1]
      interfaces: [{{ ansible_default_ipv4.interface }}]
      dhcp4: false
      dhcp6: false
      parameters:
        stp: false
        forward-delay: 0
